# 也可以不手动复制：首次打开网站会进入配置页，保存后自动写入 .env。
# 手动部署时仍可复制本文件为 .env 后填写。

# 对话模型（必填）
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

# 翻译模型（必填，只负责翻译，不复用对话模型）
TRANSLATE_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATE_API_KEY=
TRANSLATE_MODEL=Qwen/Qwen2.5-7B-Instruct

# 服务
HOST=127.0.0.1
PORT=8756
DATA_DIR=data

